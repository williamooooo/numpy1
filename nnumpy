fig = plt.figure(figsize=(12, 12))

#a
ax1 = fig.add_subplot(221, projection='3d')
#theta är hela enhetscirkeln, r radie i 50 steg
theta = np.linspace(0, 2 * np.pi, 100)
r = np.linspace(0, 1, 50)
#kombinerar r och theta för alla punkter, fyller in konen
T, R = np.meshgrid(theta, r)
#polära koordinater, cos och sin skapar hel cirkel
x1 = R * np.cos(T)
y1 = R * np.sin(T)
z1 = R
ax1.plot_surface(x1, y1, z1, color='red')
ax1.set_title("Kon")

#b
ax2 = fig.add_subplot(222, projection='3d')
#skapar en platta där mitten är origo
x2=np.linspace(-1,1,100)
y2=np.linspace(-1,1,100)
X2, Y2 = np.meshgrid(x2, y2)
#Z koordinaten tar 1 - max värdet vid givna koordinater, vid 0,0 har vi då helt enkelt Z = 1
Z2 = 1 - np.maximum(np.abs(X2), np.abs(Y2))
ax2.plot_surface(X2, Y2, Z2, color='orange')
ax2.set_title("Pyramid")

